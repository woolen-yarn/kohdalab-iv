<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="KohdaLab IV" product-version="${version}" company-name="Kohdalab">
      <include path="kohdalab-iv-next.exe" />
      <include path="iv-cli.exe" />
      <include path="support/kohdalab-usbtmc-helper.exe" />
      <include path="support/kohdalab-visa-helper.exe" />
      <include path="support/USB-Setup.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
